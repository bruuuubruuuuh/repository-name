package main

import (
	"fmt"
	"os"
)

func main() {
	var number int
	fmt.Fscan(os.Stdin, &number)
	for number < 12307 {
		if number < 0 {
			number = number * (-1)
		} else if number%7 == 0 {
			number = number * 39
		} else if number%9 == 0 {
			number = (number * 13) + 1
			continue
		} else {
			number = 3 * (number + 2)
		}
		if (number%9 == 0) && (number%13 == 0) {
			fmt.Printf("service error")
			break
		} else {
			number = number + 1
		}
		fmt.Println("ur numba ", number)

	}
	for number >= 12307 {
		fmt.Println("f u")
	}
}
